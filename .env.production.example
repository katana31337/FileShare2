# =============================================================================
# FileShare — Production Environment Configuration
# =============================================================================
# Скопируйте этот файл в .env и заполните значения
# cp .env.production.example .env
# =============================================================================

# Database (ОБЯЗАТЕЛЬНО)
DB_NAME=fileshare
DB_USER=fileshare
DB_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD_HERE

# JWT (ОБЯЗАТЕЛЬНО)
# Сгенерируйте: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Session (ОБЯЗАТЕЛЬНО)
SESSION_EXPIRY_DAYS=7
SESSION_COOKIE_NAME=fs_sid
# Сгенерируйте: openssl rand -hex 32
COOKIE_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Admin (ОБЯЗАТЕЛЬНО)
# Секретный URL для доступа к админке
# Сгенерируйте: openssl rand -hex 16
ADMIN_SECRET_PATH=/CHANGE_ME_RANDOM_SECRET_PATH

# CORS (ОБЯЗАТЕЛЬНО)
# Домен, с которого разрешены запросы
CORS_ORIGIN=https://yourdomain.com

# Optional: File upload limits
MAX_FILE_SIZE=104857600

# Optional: JWT expiration
JWT_EXPIRES_IN=24h
