# FileShare Environment Configuration
# Generated by install.sh - adjust as needed

# Database
DB_NAME=fileshare
DB_USER=fileshare
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# JWT
JWT_SECRET=CHANGE_ME_JWT_SECRET_LONG_RANDOM_STRING

# Session
SESSION_EXPIRY_DAYS=7
SESSION_COOKIE_NAME=fs_sid
COOKIE_SECRET=CHANGE_ME_COOKIE_SECRET

# Admin
ADMIN_SECRET_PATH=/admin-secret-panel

# CORS
CORS_ORIGIN=https://localhost

# SSL
SSL_TYPE=self-signed
DOMAIN=localhost
