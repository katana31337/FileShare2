# FileShare Backend Configuration
# Copy this file to .env and adjust values

# Server
NODE_ENV=development
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fileshare
DB_USER=fileshare
DB_PASSWORD=fileshare_secret

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=24h

# Upload
MAX_FILE_SIZE=104857600
UPLOAD_PATH=./uploads
ALLOWED_TYPES=*

# Session
SESSION_EXPIRY_DAYS=7
SESSION_COOKIE_NAME=fs_sid
COOKIE_SECRET=cookie-secret-change-me

# Admin
ADMIN_SECRET_PATH=/admin-secret-panel

# CORS
CORS_ORIGIN=http://localhost:3000
